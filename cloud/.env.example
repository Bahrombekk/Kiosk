# ─────────────────────────────────────────────────────────────
#  KioskCloud sozlamalari (.env)
#  Nusxa oling:   cp .env.example .env    va to'ldiring.
#  DIQQAT: .env git'ga TUSHMAYDI (.gitignore) — sirlar shu yerda qoladi.
# ─────────────────────────────────────────────────────────────

# Admin login (username). Standart "admin".
CLOUD_ADMIN_USER=admin
# Admin paroli (MAJBURIY — kuchli qo'ying). Berilmasa tasodifiy yaratiladi.
CLOUD_ADMIN_PASS=almashtiring-kuchli-parol

# Tashqi manzil — agentlar (poyezd serverlari) shu orqali fayl tortadi.
CLOUD_PUBLIC_URL=https://cloud.poyezd.uz

# ── Docker/Caddy uchun (python o'qimaydi — docker-compose ishlatadi) ──
CLOUD_DOMAIN=cloud.poyezd.uz      # HTTPS shu domenга AVTOMATIK olinadi
ACME_EMAIL=admin@poyezd.uz        # Let's Encrypt bildirishnomalari

# ── Odatda o'zgartirilmaydi ──
CLOUD_MAX_UPLOAD=8589934592       # bitta fayl chegarasi (8 GB)
# CLOUD_DL_TTL=86400              # yuklab olish havolasi muddati (soniya)
# CLOUD_OFFLINE_AFTER=90          # shu soniyaдан keyin server "offlayn"
