# ─────────────────────────────────────────────────────────────
#  Avtobus qurilmasi sozlamalari (.env)
#  Nusxa oling:   cp .env.example .env    va to'ldiring.
#  DIQQAT: .env git'ga TUSHMAYDI — sirlar shu yerda.
# ─────────────────────────────────────────────────────────────

# Backend va web BIR XIL API kalitни ishlatadi (uzun tasodifiy qiymat qo'ying).
# Yaratish: `python -c "import secrets;print(secrets.token_urlsafe(24))"`
KIOSK_API_KEY=almashtiring-uzun-tasodifiy-kalit

# Avtobus nomi (bulut panelida shu ko'rinadi)
KIOSK_NAME=Avtobus-01

# KioskCloud (bulut) domeni — qurilma shunga ulanadi, paneldan boshqariladi.
KIOSK_CLOUD_URL=cloud.poyezd.uz

# (ixtiyoriy) bir martalik ulanish kaliti — bo'lsa qurilma DARHOL tasdiqlanadi
# (aks holda panelda "Tasdiqlash" tugmasini bosasiz).
# KIOSK_CLOUD_ENROLL=

# (ixtiyoriy) statistikани bulutga qanchada yuborish (soniya)
# KIOSK_CLOUD_STATS=60
